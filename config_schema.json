{
  "type": "object",
  "properties": {
    "database": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["sqlserver", "oracle", "teradata"]
        },
        "server": {"type": "string", "minLength": 1},
        "database": {"type": "string", "minLength": 1},
        "username": {"type": "string", "minLength": 1},
        "password": {"type": "string", "minLength": 1},
        "port": {"type": "string", "minLength": 1},
        "service_name": {"type": "string", "minLength": 1},
        "schemas": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_]+\\.[a-zA-Z0-9_]+$"
          }
        },
        "column_aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9_]+\\.[a-zA-Z0-9_]+$"
          }
        }
      },
      "required": ["type"],
      "oneOf": [
        {
          "properties": {"type": {"const": "sqlserver"}},
          "required": ["server", "database", "username", "password"]
        },
        {
          "properties": {"type": {"const": "oracle"}},
          "required": ["server", "port", "service_name", "username", "password"]
        },
        {
          "properties": {"type": {"const": "teradata"}},
          "required": ["server", "database", "username", "password"]
        }
      ]
    },
    "output_dir": {"type": "string", "minLength": 1}
  },
  "required": ["database", "output_dir"],
  "additionalProperties": false
}
